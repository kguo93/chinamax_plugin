#!/usr/bin/env bash
# SessionStart hook shim: resolve the interpreter, then run the entrypoint.
# stdin (the hook event JSON) and stdout (the digest) pass through verbatim.
set -euo pipefail
CHINAMAX_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# TEMPORARY DEBUG breadcrumb (revert after E5.7 diagnosis).
printf '%s SESSION_START-SHIM-ENTRY pid=%s ppid=%s cpd=%s cwd=%s\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ 2>/dev/null || date -u 2>/dev/null || echo NOTIME)" \
  "$$" "${PPID:-?}" "${CLAUDE_PLUGIN_DATA:-<unset>}" "$(pwd)" \
  >> "${HOME}/chinamax-hook-debug.log" 2>/dev/null || true
# shellcheck source=scripts/_interpreter.sh
. "${CHINAMAX_SCRIPT_DIR}/_interpreter.sh"
chinamax_exec chinamax.hooks.session_start "$@"
