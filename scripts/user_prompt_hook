#!/usr/bin/env bash
# UserPromptSubmit hook shim: resolve the interpreter, then run the entrypoint.
# stdin (the hook event JSON) and stdout (the roster additionalContext) pass verbatim.
set -euo pipefail
CHINAMAX_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=scripts/_interpreter.sh
. "${CHINAMAX_SCRIPT_DIR}/_interpreter.sh"
chinamax_exec chinamax.hooks.user_prompt "$@"
