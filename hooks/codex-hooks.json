{
  "description": "Codex-native ChinamaX lifecycle and Bridge hooks. Windows handlers explicitly enter Git Bash so the shared Runtime shell contract remains unchanged.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/session_start_hook\"",
            "commandWindows": "cmd /d /c \"\"%PLUGIN_ROOT%\\scripts\\codex_hook_bash.cmd\" session_start_hook\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/session_end_hook\"",
            "commandWindows": "cmd /d /c \"\"%PLUGIN_ROOT%\\scripts\\codex_hook_bash.cmd\" session_end_hook\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/stop_hook\"",
            "commandWindows": "cmd /d /c \"\"%PLUGIN_ROOT%\\scripts\\codex_hook_bash.cmd\" stop_hook\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/user_prompt_hook\"",
            "commandWindows": "cmd /d /c \"\"%PLUGIN_ROOT%\\scripts\\codex_hook_bash.cmd\" user_prompt_hook\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/bridge_contract_hook\"",
            "commandWindows": "cmd /d /c \"\"%PLUGIN_ROOT%\\scripts\\codex_hook_bash.cmd\" bridge_contract_hook\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Bash|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/codex_pretool_hook\"",
            "commandWindows": "cmd /d /c \"\"%PLUGIN_ROOT%\\scripts\\codex_hook_bash.cmd\" codex_pretool_hook\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "chinamax:chinamax|chinamax_bridge|chinamax[-_].*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/bridge_contract_hook\"",
            "commandWindows": "cmd /d /c \"\"%PLUGIN_ROOT%\\scripts\\codex_hook_bash.cmd\" bridge_contract_hook\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
